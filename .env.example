# Gateway MCP server URL (Streamable HTTP endpoint)
GATEWAY_MCP_URL=https://agent-auth-gateway-mcp-1031148889398.us-central1.run.app/mcp

# Gateway REST API (for /keys, /health, etc.)
GATEWAY_REST_URL=https://agent-auth-gateway-1031148889398.us-central1.run.app

# Protected resource URL
RESOURCE_URL=https://agent-auth-gateway-resource-1031148889398.us-central1.run.app

# Gateway REST API /keys endpoint (for fetching the signing public key)
GATEWAY_KEYS_URL=https://agent-auth-gateway-1031148889398.us-central1.run.app/keys

# MCP bearer token for transport auth.
# NOTE: The CLIENT reads MCP_BEARER_TOKEN; the GATEWAY reads MCP_AUTH_TOKEN.
# Both sides must have the same value.
MCP_BEARER_TOKEN=your-shared-secret-here
